# WhatsApp Alert Configuration
# Copy this file to .env and fill in your real credentials.
# Never commit .env to version control.


# ── Alert recipient ───────────────────────────────────────────────────────────
# The WhatsApp-enabled number that should receive godown alerts.
# Format: whatsapp:+<country_code><number>  (no spaces or dashes)
# Example: whatsapp:+919876543210
ALERT_WHATSAPP_TO=whatsapp:+919494294249

# ── Alert behaviour ───────────────────────────────────────────────────────────
# Minimum risk score (0-100) that triggers a WhatsApp alert.
RISK_ALERT_THRESHOLD=70

# Cooldown in minutes before re-alerting the same zone while it stays red.
ALERT_COOLDOWN_MINUTES=1
